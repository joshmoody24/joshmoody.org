---
interface Props {
  number: number;
}

const { number } = Astro.props;
---
<div
  id={`footnote-${number}`}
  role="note"
  aria-labelledby={`footnote-${number}-ref`}
  popover="auto"
  style={`position-anchor: --footnote-${number}`}
><slot /></div>

<style>
  div[popover] {
    background-color: var(--color-background);
    padding: var(--spacing-md);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    max-width: min(420px, calc(100vw - 2rem));
    max-height: min(70dvh, calc(100dvh - 2rem));
    overflow: auto;
    overscroll-behavior: contain;
    position: fixed;
    inset: auto;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
  }

  /* Modern desktop behavior: place near the footnote reference when space allows. */
  @media (min-width: 48rem) {
    @supports (anchor-name: --foo) {
      div[popover] {
        inset: unset;
        margin: 0;
        margin-inline: 1rem;
        position: absolute;
        top: calc(anchor(bottom) + 8px);
        justify-self: anchor-center;
        transform: none;
        max-height: min(60dvh, calc(100dvh - 2rem));
        position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
      }
    }
  }

  /* Fallback: keep footnotes centered when CSS Anchor Positioning is unavailable. */
  @media (min-width: 48rem) {
    @supports not (anchor-name: --foo) {
      div[popover] {
        max-width: min(420px, calc(100vw - 4rem));
      }
    }
  }

  /* ::backdrop styling for popovers is unreliable in Safari/WebKitGTK —
     background-color and backdrop-filter don't consistently apply. Use a
     body::before overlay instead (see is:global block below). */
  /* div[popover]::backdrop {
    backdrop-filter: brightness(0.67);
  } */
</style>

<style is:global>
  body:has([popover]:popover-open)::before {
    content: '';
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.33);
    z-index: 9999;
  }
</style>
