---
interface Props {
  number: number;
}

const { number } = Astro.props;
---
<div
  id={`footnote-${number}`}
  role="note"
  aria-labelledby={`footnote-${number}-ref`}
  popover="auto"
  anchor={`footnote-${number}-btn`}
><slot /></div>

<style>
  div[popover] {
    background-color: var(--color-background);
    padding: var(--spacing-md);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    max-width: min(350px, 90vw);
  }

  /* CSS Anchor Positioning: position near the trigger button */
  @supports (anchor-name: --foo) {
    div[popover] {
      inset: unset;
      margin: 0;
      margin-inline: 1rem;
      position: absolute;
      top: calc(anchor(bottom) + 8px);
      justify-self: anchor-center;
    }
  }

  /* Fallback for browsers without CSS Anchor Positioning (mobile Safari, Firefox) */
  @supports not (anchor-name: --foo) {
    div[popover] {
      position: fixed;
      inset: auto;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      margin: 0;
    }
  }

  /* ::backdrop styling for popovers is unreliable in Safari/WebKitGTK —
     background-color and backdrop-filter don't consistently apply. Use a
     body::before overlay instead (see is:global block below). */
  /* div[popover]::backdrop {
    backdrop-filter: brightness(0.67);
  } */
</style>

<style is:global>
  body:has([popover]:popover-open)::before {
    content: '';
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.33);
    z-index: 9999;
  }
</style>
